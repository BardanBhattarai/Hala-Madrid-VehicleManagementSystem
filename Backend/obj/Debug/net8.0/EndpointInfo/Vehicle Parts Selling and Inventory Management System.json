  "components": {
    "schemas": {
      "CreatePartDto": {
        "type": "object",
        "properties": {
          "partName": {
            "type": "string",
            "nullable": true
          },
          "stockQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateSalesInvoiceDto": {
        "required": [
          "customerId",
          "items"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "staffId": {
            "type": "string",
            "nullable": true
          },
          "paidAmount": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesInvoiceItemCreateDto"
            }
          }
        },
        "additionalProperties": false
      },
      "CreateVendorDto": {
        "required": [
          "companyName",
          "contactPerson",
          "phoneNumber",
          "vendorName"
        ],
        "type": "object",
        "properties": {
          "vendorName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "contactPerson": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 200,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "companyName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterCustomerWithVehicleDto": {
        "required": [
          "fullName",
          "phoneNumber",
          "vehicle"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 200,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleCreateDto"
          }
        },
        "additionalProperties": false
      },
      "SalesInvoiceItemCreateDto": {
        "required": [
          "partId"
        ],
        "type": "object",
        "properties": {
          "partId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpdateVendorDto": {
        "required": [
          "companyName",
          "contactPerson",
          "phoneNumber",
          "vendorName"
        ],
        "type": "object",
        "properties": {
          "vendorName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "contactPerson": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 200,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "companyName": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "VehicleCreateDto": {
        "required": [
          "brand",
          "model",
          "vehicleNumber"
        ],
        "type": "object",
        "properties": {
          "vehicleNumber": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "brand": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "model": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "vehicleType": {
            "maxLength": 50,
            "type": "string",
            "nullable": true
          },
          "manufactureYear": {
            "type": "integer",
            "format": "int32"
          },
          "mileage": {
            "type": "integer",
            "format": "int32"
          },
          "lastServiceDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Enter: Bearer {your JWT token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
